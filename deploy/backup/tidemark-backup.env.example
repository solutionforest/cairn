# /etc/default/tidemark-backup (chmod 600: it holds a secret key)
TIDEMARK_ENDPOINT=http://127.0.0.1:9000
TIDEMARK_ACCESS_KEY=change-me                # the `backup` user from backup-user-policy.json
TIDEMARK_SECRET_KEY=change-me
BACKUP_ROOT=/var/backups/tidemark          # must equal backup.dir in tidemark.toml
KEEP_SETS=4
RCLONE_REMOTE=offsite:tidemark-backup
