# systemd unit for Cairn.
#   install -m 0755 cairn /usr/local/bin/cairn
#   useradd --system --home /var/lib/cairn --shell /usr/sbin/nologin cairn
#   install -d -o cairn -g cairn -m 0750 /var/lib/cairn /etc/cairn
#   install -m 0640 -g cairn deploy/cairn.example.toml /etc/cairn/cairn.toml   # then edit
#   sudo -u cairn cairn init --data-dir /var/lib/cairn                          # prints root keys once
#   install -m 0644 deploy/cairn.service /etc/systemd/system/ && systemctl enable --now cairn
[Unit]
Description=Cairn S3-compatible object storage
Documentation=https://github.com/solutionforest/cairn
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=cairn
Group=cairn
Environment=CAIRN_DATA_DIR=/var/lib/cairn
# Secrets (e.g. CAIRN_ROOT_SECRET) belong in a root-owned 0600 file, not in this unit:
EnvironmentFile=-/etc/cairn/cairn.env
ExecStart=/usr/local/bin/cairn serve --config /etc/cairn/cairn.toml
Restart=on-failure
RestartSec=2s
# Graceful shutdown drains requests and flushes the metadata writer (PRODUCTION-READINESS C9).
KillSignal=SIGTERM
TimeoutStopSec=60s
LimitNOFILE=65536

# Hardening: Cairn only needs its data dir, its config and the network.
StateDirectory=cairn
StateDirectoryMode=0750
ReadWritePaths=/var/lib/cairn
ReadOnlyPaths=/etc/cairn
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
# To bind :443/:80 directly instead of behind a proxy, use:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0027

[Install]
WantedBy=multi-user.target
