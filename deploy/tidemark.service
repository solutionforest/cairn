# systemd unit for Tidemark.
#   install -m 0755 tidemark /usr/local/bin/tidemark
#   useradd --system --home /var/lib/tidemark --shell /usr/sbin/nologin tidemark
#   install -d -o tidemark -g tidemark -m 0750 /var/lib/tidemark /etc/tidemark
#   install -m 0640 -g tidemark deploy/tidemark.example.toml /etc/tidemark/tidemark.toml   # then edit
#   sudo -u tidemark tidemark init --data-dir /var/lib/tidemark                          # prints root keys once
#   install -m 0644 deploy/tidemark.service /etc/systemd/system/ && systemctl enable --now tidemark
[Unit]
Description=Tidemark S3-compatible object storage
Documentation=https://github.com/solutionforest/tidemark
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=tidemark
Group=tidemark
Environment=TIDEMARK_DATA_DIR=/var/lib/tidemark
# Secrets (e.g. TIDEMARK_ROOT_SECRET) belong in a root-owned 0600 file, not in this unit:
EnvironmentFile=-/etc/tidemark/tidemark.env
ExecStart=/usr/local/bin/tidemark serve --config /etc/tidemark/tidemark.toml
Restart=on-failure
RestartSec=2s
# Graceful shutdown drains requests and flushes the metadata writer (PRODUCTION-READINESS C9).
KillSignal=SIGTERM
TimeoutStopSec=60s
LimitNOFILE=65536

# Hardening: Tidemark only needs its data dir, its config and the network.
StateDirectory=tidemark
StateDirectoryMode=0750
ReadWritePaths=/var/lib/tidemark
ReadOnlyPaths=/etc/tidemark
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
# To bind :443/:80 directly instead of behind a proxy, use:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0027

[Install]
WantedBy=multi-user.target
